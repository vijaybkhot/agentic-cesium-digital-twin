# Optional: enables Cesium ion world imagery and disaster-demo OSM Buildings.
# Copy this file to .env.local and replace the placeholder with your own token.
VITE_CESIUM_ION_ACCESS_TOKEN=replace_with_your_cesium_ion_token

# Optional urban-demo 3D context. Off by default because the urban demo already
# renders selectable, risk-classified OpenStreetMap building footprints.
VITE_ENABLE_URBAN_OSM_BUILDINGS=false

# Optional ArcGIS Location Platform key for the isolated SceneView experiment.
# Grant only Basemap styles and Elevation service privileges. Never commit a
# real key; put it in .env.local and restrict it to approved HTTP referrers.
VITE_ARCGIS_API_KEY=replace_with_your_arcgis_api_key
